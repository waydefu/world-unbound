{
  "name": "WORLD UNBOUND | lean Node 22 development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/setup-tools.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
