{
  "name": "world-unbound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit": "node scripts/audit.mjs",
    "audit:visual": "node scripts/audit-visual.mjs",
    "postaudit:visual": "node tools/turf-smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run audit && npm run audit:visual -- --skip-build",
    "lint": "biome lint --error-on-warnings",
    "check:quiet": "node tools/check-quiet.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@babylonjs/core": "9.33.2",
    "@biomejs/biome": "2.6.4",
    "@types/three": "0.187.0",
    "@webgpu/types": "0.1.74",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
